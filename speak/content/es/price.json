  "registerNotes": {
    "familiar": "At the market, the buyer and the seller say usted to each other. In Colombia that is the norm."
  },
  "lines": {
    "l1": {
      "text": "¡Buenas! ¿A cómo están {item}?",
      "accept": [
        "¡Buenas! ¿A cómo tiene {item}?",
        "¡Buenas! ¿Cuánto valen {item}?"
      ]
    },
    "l2": {
      "text": "A cuatro mil pesos el kilo.",
      "accept": [
        "A 4000 pesos el kilo.",
        "A 4.000 pesos el kilo.",
        "Cuatro mil pesos el kilo.",
        "4000 pesos el kilo."
      ]
    },
    "l3": {
      "text": "¡Uy, qué caro! ¿Me hace una rebajita?",
      "accept": [
        "¡Uy, qué caro! ¿Me lo deja más barato?"
      ]
    },
    "l4": {
      "text": "Bueno, se lo dejo en tres mil quinientos.",
      "accept": [
        "Bueno, se lo dejo en 3500.",
        "Bueno, se lo dejo en 3.500.",
        "Bueno, para usted, tres mil quinientos."
      ]
    },
    "l5": {
      "text": "Listo, me llevo un kilo.",
      "accept": [
        "Bueno, me llevo un kilo.",
        "Listo, me llevo un kilo, por favor."
      ]
    },
    "l6": {
      "text": "Aquí tiene.",
      "accept": [
        "Aquí tiene. ¡Gracias!",
        "Con mucho gusto, aquí tiene."
      ]
    }
  },
