      "id": "l1",
      "role": "A",
      "en": "Would you like to come to {event} on Saturday?",
      "addressesYou": true
    },
    {
      "id": "l2",
      "role": "B",
      "en": "I'd love to! What time?"
    },
    {
      "id": "l3",
      "role": "A",
      "en": "At seven, at my place."
    },
    {
      "id": "l4",
      "role": "B",
      "en": "Can I bring something?"
    },
    {
      "id": "l5",
      "role": "A",
      "en": "No need. Just come!",
      "addressesYou": true
    }
  ],
  "chunks": [
    {
      "id": "would-you-like",
