{
  "schema": 2,
  "id": "invite",
  "title": "Would you like to come?",
  "goal": "Invite someone, accept an invitation, and say no politely.",
  "roles": {
    "A": "Invites",
    "B": "Is invited"
  },
  "slots": {
    "event": {
      "kind": "set",
      "cue": "an event"
    }
  },
