{
  "schema": 2,
  "id": "price",
  "title": "At the market",
  "goal": "Ask the price, bargain a little, and buy.",
  "roles": {
    "A": "Buys",
    "B": "Sells"
  },
  "slots": {
    "item": {
      "kind": "set",
      "cue": "a fruit or vegetable"
    }
  },
  "lines": [
    {
      "id": "l1",
      "role": "A",
      "en": "Hello! How much are the {item}?"
    },
    {
      "id": "l2",
      "role": "B",
      "en": "(A price) a kilo."
    },
    {
      "id": "l3",
      "role": "A",
      "en": "That's expensive! A little cheaper?",
      "addressesYou": true
    },
    {
      "id": "l4",
      "role": "B",
      "en": "OK, (a lower price) for you.",
      "addressesYou": true
    },
    {
      "id": "l5",
      "role": "A",
      "en": "Fine, I'll take one kilo."
    },
    {
      "id": "l6",
      "role": "B",
      "en": "Here you are.",
      "addressesYou": true
    }
  ],
  "chunks": [
    {
      "id": "how-much-are",
      "en": "how much are the ___?"
    },
    {
      "id": "a-kilo",
      "en": "___ a kilo"
    },
    {
      "id": "thats-expensive",
      "en": "that's expensive!"
    },
    {
      "id": "a-bit-cheaper",
      "en": "a little cheaper?",
      "addressesYou": true
    },
    {
      "id": "ill-take",
      "en": "I'll take ___"
    },
    {
      "id": "here-you-are",
      "en": "here you are",
      "addressesYou": true
    },
    {
      "id": "too-much",
      "en": "that's too much"
    }
  ],
  "drill": {
    "slot": "item",
    "instruction": "Swap the fruit or vegetable each time."
  },
  "free": {
    "prompt": "Set up a market. Sellers ask high prices; buyers bargain politely.",
    "targets": [
      {
        "id": "last-price",
        "en": "what's your last price?",
        "addressesYou": true
      },
      {
        "id": "ok-deal",
        "en": "OK, it's a deal"
      }
    ]
  }
}
