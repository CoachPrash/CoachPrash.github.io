{
  "schema": 2,
  "id": "opinions",
  "title": "Small talk & opinions",
  "goal": "Make small talk about the weekend and say what you thought of something.",
  "roles": {
    "A": "Starts the chat",
    "B": "Joins in"
  },
  "slots": {
    "opinion": {
      "kind": "set",
      "cue": "an opinion (great, boring…)"
    }
  },
  "lines": [
    {
      "id": "l1",
      "role": "A",
      "en": "Nice weather today, isn't it?"
    },
    {
      "id": "l2",
      "role": "B",
      "en": "Yes, very nice! What did you do at the weekend?",
      "addressesYou": true
    },
    {
      "id": "l3",
      "role": "A",
      "en": "I watched a film."
    },
    {
      "id": "l4",
      "role": "B",
      "en": "Oh nice! How was it?"
    },
    {
      "id": "l5",
      "role": "A",
      "en": "It was {opinion}. And how was your weekend?",
      "addressesYou": true
    },
    {
      "id": "l6",
      "role": "B",
      "en": "Quiet. I stayed at home."
    }
  ],
  "chunks": [
    {
      "id": "nice-weather",
